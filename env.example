# Copy this file to .env for local development.
# On Railway, set these under your service's "Variables" tab instead.

# Any long random string — used to sign login sessions.
SESSION_SECRET=change-this-to-a-long-random-string

# Where the SQLite database file lives. Leave as-is locally.
# On Railway, point this at a mounted Volume (see README) so your
# inventory data survives redeploys, e.g. DB_PATH=/data/inventory.db
DB_PATH=./data/inventory.db

PORT=3000
